{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core001.local/schemas/ontology.schema.json",
  "title": "Ontology: document header and terms",
  "type": "object",
  "required": ["document", "terms"],
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object",
      "required": ["id", "title", "revision", "source", "slice", "slice_title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "slice": { "type": "string", "pattern": "^SLICE-[A-Z0-9.-]+$" },
        "slice_title": { "type": "string", "minLength": 1 }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition", "fragment", "source_ref"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^TERM-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "fragment": { "type": "string", "pattern": "^FRAG-[A-Za-z0-9._-]+$" },
          "source_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
