{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core001.local/schemas/sources.schema.json",
  "title": "Sources and verbatim fragments",
  "type": "object",
  "required": ["sources", "slice", "fragments"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "description": "MVP: ровно один источник. Multi-source не поддерживается и явно не разрешён.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "document", "revision"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "document": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "slice": {
      "type": "object",
      "required": ["id", "includes", "excludes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^SLICE-[A-Z0-9.-]+$" },
        "includes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^#[0-9.]+$" }
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9.]+$" }
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "source_ref", "quote"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^FRAG-[A-Za-z0-9._-]+$" },
          "source": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "source_ref": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "in_scope": { "type": "boolean" }
        }
      }
    }
  }
}
