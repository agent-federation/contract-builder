{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core001.local/schemas/sources.schema.json",
  "title": "Sources and verbatim fragments",
  "type": "object",
  "required": [
    "slice",
    "fragments"
  ],
  "additionalProperties": false,
  "properties": {
    "slice": {
      "type": "object",
      "required": [
        "id",
        "includes",
        "excludes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SLICE-[A-Z0-9.-]+$"
        },
        "includes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^#[0-9.]+$"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9.]+$"
          }
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://core001.local/schemas/fragment.schema.json#/$defs/base"
      }
    }
  }
}
