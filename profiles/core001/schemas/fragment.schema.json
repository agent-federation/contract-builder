{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core001.local/schemas/fragment.schema.json",
  "title": "Entity: verbatim fragment",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "id",
        "source",
        "source_ref",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FRAG-[A-Za-z0-9._-]+$"
        },
        "source": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        },
        "relations": {
          "type": "object"
        },
        "review": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    }
  ]
}
