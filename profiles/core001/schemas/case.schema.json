{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core001.local/schemas/case.schema.json",
  "title": "Entity: conformance case",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "id",
        "scenario",
        "expected_outcome",
        "source_determination",
        "expectation_basis",
        "rationale",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CASE-[A-Z0-9-]+$"
        },
        "scenario": {
          "type": "object",
          "required": [
            "given",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "given": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected_outcome": {
          "enum": [
            "satisfied",
            "violated"
          ]
        },
        "source_determination": {
          "enum": [
            "determined",
            "inferred",
            "underdetermined",
            "not_asserted_by_source"
          ]
        },
        "expectation_basis": {
          "enum": [
            "obligation",
            "prohibition",
            "permission",
            "permission_with_necessary_condition",
            "negative_entailment",
            "semantic_constraint",
            "scope_statement",
            "absent"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unreviewed",
                "confirmed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "kind": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        },
        "relations": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "required": [
        "relations"
      ],
      "properties": {
        "relations": {
          "type": "object",
          "required": [
            "provision",
            "rationaleFragment"
          ],
          "properties": {
            "provision": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "rationaleFragment": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
