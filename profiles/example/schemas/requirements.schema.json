{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/requirements.schema.json",
  "title": "Example project requirements document",
  "type": "object",
  "required": [
    "requirements"
  ],
  "additionalProperties": false,
