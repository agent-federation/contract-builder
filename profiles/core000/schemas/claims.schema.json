{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core000.local/schemas/claims.schema.json",
  "title": "CORE-000 claims document",
  "type": "object",
  "required": [
    "sourceStatements",
    "claims",
    "evidence",
    "independentVerifications",
    "decisions",
    "conformanceCases"
  ],
  "additionalProperties": false,
  "properties": {
    "sourceStatements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://core000.local/schemas/source-statement.schema.json" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://core000.local/schemas/claim.schema.json" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://core000.local/schemas/evidence.schema.json" }
    },
    "independentVerifications": {
      "type": "array",
      "items": { "$ref": "https://core000.local/schemas/independent-verification.schema.json" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://core000.local/schemas/decision.schema.json" }
    },
    "conformanceCases": {
      "type": "array",
      "items": { "$ref": "https://core000.local/schemas/conformance-case.schema.json" }
    }
  }
}
