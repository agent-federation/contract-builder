{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core000.local/schemas/independent-verification.schema.json",
  "title": "Entity: independent_verification",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "id",
        "method",
        "verifier",
        "independence",
        "independence_basis",
        "performed",
        "result",
        "scope",
        "revision",
        "claim_results",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^VF-[A-Z0-9-]+$" },
        "method": {
          "enum": ["manual_review", "external_harness", "cross_implementation", "command_run"]
        },
        "verifier": { "type": "string", "minLength": 1 },
        "independence": { "enum": ["author", "non_author", "independent", "unknown"] },
        "independence_basis": { "type": "string", "minLength": 1 },
        "performed": { "type": "boolean" },
        "result": { "enum": ["confirmed", "refuted", "inconclusive", "not_run"] },
        "scope": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "claim_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim", "result", "evidence"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string", "pattern": "^C000-[A-Z]{2,4}-[0-9]{3}$" },
              "result": { "enum": ["confirmed", "refuted", "inconclusive", "not_run"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "limitations": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "date": { "type": "string", "minLength": 1 },
        "record_locator": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "provenance": { "type": "object" },
        "verification": { "type": "object" },
        "relations": { "type": "object" },
        "review": { "type": "object" }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/base" },
    {
      "if": { "properties": { "method": { "enum": ["command_run", "external_harness"] } }, "required": ["method"] },
      "then": { "required": ["commands"] }
    },
    {
      "if": { "properties": { "performed": { "const": true } }, "required": ["performed"] },
      "then": { "required": ["date"] }
    },
    {
      "if": {
        "properties": {
          "performed": { "const": true },
          "result": { "not": { "const": "not_run" } }
        },
        "required": ["performed", "result"]
      },
      "then": { "required": ["record_locator"] }
    }
  ]
}
