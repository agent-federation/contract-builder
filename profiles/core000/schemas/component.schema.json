{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core000.local/schemas/component.schema.json",
  "title": "Entity: component",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "name", "responsibility", "boundary", "public"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^COMP-[A-Z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "responsibility": { "type": "string", "minLength": 1 },
        "boundary": { "enum": ["engine", "profile", "project", "consumer", "external"] },
        "public": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "provenance": { "type": "object" },
        "verification": { "type": "object" },
        "relations": { "type": "object" },
        "review": { "type": "object" }
      }
    }
  },
  "allOf": [{ "$ref": "#/$defs/base" }]
}
