{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core000.local/schemas/extension-point.schema.json",
  "title": "Entity: extension_point",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "name", "mechanism", "trust", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^EXT-[A-Z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "mechanism": { "enum": ["dynamic_import", "consumer_registry", "static_import"] },
        "trust": { "enum": ["trusted_in_process", "trusted_consumer_supplied"] },
        "status": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "provenance": { "type": "object" },
        "verification": { "type": "object" },
        "relations": { "type": "object" },
        "review": { "type": "object" }
      }
    }
  },
  "allOf": [{ "$ref": "#/$defs/base" }]
}
