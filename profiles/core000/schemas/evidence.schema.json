{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core000.local/schemas/evidence.schema.json",
  "title": "Entity: evidence",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "kind", "locator", "revision", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
        "kind": { "enum": ["code", "test", "ci", "source", "review", "analysis", "build"] },
        "locator": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "independence": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "provenance": { "type": "object" },
        "verification": { "type": "object" },
        "relations": { "type": "object" },
        "review": { "type": "object" }
      }
    }
  },
  "allOf": [{ "$ref": "#/$defs/base" }]
}
