{
  "name": "core001-spec-builder",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "description": "Prototype builder for a machine-readable normative specification (CORE-001 slice §10.1-10.2)",
  "scripts": {
    "build": "bun spec/build.ts --mode draft --allow-executable-profile",
    "build:release": "bun spec/build.ts --mode release --allow-executable-profile",
    "check": "bun spec/build.ts --mode draft --check --allow-executable-profile",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "nunjucks": "^3.2.4",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.6.3"
  }
}
