{
  "name": "core001-spec-builder",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "description": "Prototype builder for a machine-readable normative specification (CORE-001 slice §10.1-10.2) plus the independent PAP v0.1 verifier",
  "bin": {
    "pap": "pap/bin/pap"
  },
  "scripts": {
    "build": "bun spec/build.ts --mode draft --allow-executable-profile --renderer-module profiles/core001/renderer.ts",
    "build:release": "bun spec/build.ts --mode release --allow-executable-profile --renderer-module profiles/core001/renderer.ts",
    "check": "bun spec/build.ts --mode draft --check --allow-executable-profile --renderer-module profiles/core001/renderer.ts",
    "check:all": "bun run check && bun test tests/core000.test.ts -t \"S2.2 artifact verification\"",
    "release:check": "bun pipeline/release.ts",
    "pap": "bun pap/src/cli.ts",
    "pap:test": "bun test pap/tests",
    "pack:core000": "bun pipeline/pack.ts",
    "gate:core000": "bun pipeline/gate.ts",
    "pipeline:independent": "bun pipeline/independent.ts",
    "pipeline:evidence": "bun pipeline/evidence.ts",
    "pipeline:test": "bun test pipeline/tests",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "nunjucks": "^3.2.4",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.6.3"
  }
}
